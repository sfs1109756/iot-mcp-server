{
  "name": "iot-mcp-server-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --dashboard-only",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "start:mcp": "node dist/index.js",
    "agent": "tsx src/agent-cli.ts",
    "agent:prod": "node dist/agent-cli.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "demo": "tsx src/demo-client.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "iot-mcp-server": "dist/index.js"
  }
}
