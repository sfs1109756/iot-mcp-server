# Server port
PORT=3003

# ---- AI provider -------------------------------------------------------
# ollama (default, local, free) | openai (any OpenAI-compatible API) | anthropic | none
LLM_PROVIDER=ollama
# Leave empty for the provider default (ollama: qwen2.5:7b)
LLM_MODEL=

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# OpenAI-compatible (OpenAI, LM Studio http://localhost:1234/v1, Groq, vLLM...)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

LLM_TIMEOUT_MS=180000

# ---- Devices -----------------------------------------------------------
# sim (built-in simulator) | http (real ESP32s listed in DEVICES_FILE)
DEVICE_ADAPTER=sim
DEVICES_FILE=./devices.json
POLL_MS=5000
# Simulator: tick interval and speed-up factor (5 = effects visible within ~30s)
SIM_TICK_MS=3000
SIM_SPEED=5
AGENT_MAX_STEPS=10

# ---- MQTT (DEVICE_ADAPTER=mqtt) ---------------------------------------
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=iot
MQTT_USERNAME=
MQTT_PASSWORD=
# Run a broker inside this server (no Mosquitto needed); ESP32s connect to MQTT_PORT
MQTT_EMBEDDED_BROKER=false
MQTT_PORT=1883
MQTT_STALE_SECONDS=60

# Listen address. 127.0.0.1 = this computer only; 0.0.0.0 = your network
HOST=127.0.0.1
